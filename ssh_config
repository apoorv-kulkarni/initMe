# GitHub SSH: bootstrap creates id_ed25519; older machines may use gigithub_2024 or github_rsa.
# IgnoreUnknown keeps UseKeychain valid on macOS without errors on Linux/Pi OpenSSH.
Host github.com
  IgnoreUnknown UseKeychain
  AddKeysToAgent yes
  UseKeychain yes
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_ed25519
  IdentityFile ~/.ssh/gigithub_2024
  IdentityFile ~/.ssh/github_rsa
